# Stripe (test mode first — see README checklist for live)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Database (libSQL / Turso) ---
# Local dev (default): file-backed SQLite via libSQL — no Turso account needed
# TURSO_DATABASE_URL=file:./data/rankbid.db
#
# Production (Vercel): create a Turso DB, then set BOTH:
#   TURSO_DATABASE_URL=libsql://your-db-name-user.turso.io
#   TURSO_AUTH_TOKEN=eyJ...
#
# DATABASE_URL is accepted as an alias for TURSO_DATABASE_URL.
TURSO_DATABASE_URL=file:./data/rankbid.db
TURSO_AUTH_TOKEN=
# DATABASE_URL=file:./data/rankbid.db

# How long a successful takeover locks #1 (hours)
TAKEOVER_HOURS=6

# Short-lived reservation while a takeover Checkout is open (minutes)
PENDING_TAKEOVER_MINUTES=20

# Public site URL used for Stripe success/cancel redirects
NEXT_PUBLIC_BASE_URL=http://localhost:3000
